# Godot 4 cache and machine-local files (generated by the editor)
.godot/
.import/
*.import
*.translation

# Toolchain cache (large redownloadable installers). Scripts and
# TOOLCHAIN.txt are checked in; binaries and download zips are not.
tools/build/cache/
tools/build/godot/
tools/build/gut-source/
tools/build/godot-templates*/
tools/build/templates/
tools/build/android-sdk/
tools/build/setup.log

# Editor and OS temp files
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and crash dumps
*.log
logs/
*.stackdump

# Local build outputs (root-only)
/build/
/dist/
/out/

# Android export artifacts (signing keys must never be committed)
*.apk
*.aab
*.keystore
*.jks
google-play-key.json
play-store-credentials.json

# Python / tooling caches
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local environment files
.env
.env.*
!.env.example